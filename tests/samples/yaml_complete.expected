# Expected syntax highlighting for yaml_complete.yaml
# Generated from YAML grammar
# Format: <TYPE>text</TYPE> where TYPE is the token type

<COMMENT># A complete YAML example demonstrating various syntax elements</COMMENT>
<KEYWORD>---</KEYWORD>
<COMMENT># Document metadata</COMMENT>
<VARIABLE>name</VARIABLE><PUNCTUATION>:</PUNCTUATION> example<PUNCTUATION>-</PUNCTUATION>project
<VARIABLE>version</VARIABLE><PUNCTUATION>:</PUNCTUATION> <STRING>"1.0.0"</STRING>
<VARIABLE>description</VARIABLE><PUNCTUATION>:</PUNCTUATION> A complete YAML example

<COMMENT># Boolean values</COMMENT>
<VARIABLE>enabled</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>true</KEYWORD>
<VARIABLE>debug</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>false</KEYWORD>
<VARIABLE>production</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>yes</KEYWORD>
<VARIABLE>staging</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>no</KEYWORD>
<VARIABLE>on_flag</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>on</KEYWORD>
<VARIABLE>off_flag</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>off</KEYWORD>

<COMMENT># Null values</COMMENT>
<VARIABLE>empty_value</VARIABLE><PUNCTUATION>:</PUNCTUATION> <KEYWORD>null</KEYWORD>
<VARIABLE>tilde_null</VARIABLE><PUNCTUATION>:</PUNCTUATION> ~

<COMMENT># Numbers</COMMENT>
<VARIABLE>integer</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>42</NUMBER>
<VARIABLE>negative</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>-17</NUMBER>
<VARIABLE>float</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>3.14159</NUMBER>
<VARIABLE>scientific</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>1.5e+10</NUMBER>
<VARIABLE>hex</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>0xFF</NUMBER>
<VARIABLE>octal</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>0o755</NUMBER>
<VARIABLE>infinity</VARIABLE><PUNCTUATION>:</PUNCTUATION> .inf
<VARIABLE>negative_infinity</VARIABLE><PUNCTUATION>:</PUNCTUATION> <PUNCTUATION>-</PUNCTUATION>.inf
<VARIABLE>not_a_number</VARIABLE><PUNCTUATION>:</PUNCTUATION> .nan

<COMMENT># Strings</COMMENT>
<VARIABLE>simple_string</VARIABLE><PUNCTUATION>:</PUNCTUATION> Hello World
<VARIABLE>quoted_double</VARIABLE><PUNCTUATION>:</PUNCTUATION> <STRING>"Hello \"World\""</STRING>
<VARIABLE>quoted_single</VARIABLE><PUNCTUATION>:</PUNCTUATION> <STRING>'Hello '</STRING><STRING>'World'</STRING><STRING>''</STRING>
<VARIABLE>multiline_folded</VARIABLE><PUNCTUATION>:</PUNCTUATION> <OPERATOR>></OPERATOR>
  This is a folded
  multiline string that
  becomes a single line.
<VARIABLE>multiline_literal</VARIABLE><PUNCTUATION>:</PUNCTUATION> <OPERATOR>|</OPERATOR>
  This is a literal
  multiline string that
  preserves newlines.

<COMMENT># Collections</COMMENT>
<VARIABLE>simple_list</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <PUNCTUATION>-</PUNCTUATION> item<NUMBER>1</NUMBER>
  <PUNCTUATION>-</PUNCTUATION> item<NUMBER>2</NUMBER>
  <PUNCTUATION>-</PUNCTUATION> item<NUMBER>3</NUMBER>

<VARIABLE>inline_list</VARIABLE><PUNCTUATION>:</PUNCTUATION> <PUNCTUATION>[</PUNCTUATION>one<PUNCTUATION>,</PUNCTUATION> two<PUNCTUATION>,</PUNCTUATION> three<PUNCTUATION>]</PUNCTUATION>

<VARIABLE>nested_list</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <PUNCTUATION>-</PUNCTUATION> <PUNCTUATION>-</PUNCTUATION> nested<NUMBER>1</NUMBER>
    <PUNCTUATION>-</PUNCTUATION> nested<NUMBER>2</NUMBER>
  <PUNCTUATION>-</PUNCTUATION> <PUNCTUATION>-</PUNCTUATION> nested<NUMBER>3</NUMBER>

<VARIABLE>simple_map</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <VARIABLE>key1</VARIABLE><PUNCTUATION>:</PUNCTUATION> value<NUMBER>1</NUMBER>
  <VARIABLE>key2</VARIABLE><PUNCTUATION>:</PUNCTUATION> value<NUMBER>2</NUMBER>

<VARIABLE>inline_map</VARIABLE><PUNCTUATION>:</PUNCTUATION> <PUNCTUATION>{</PUNCTUATION><VARIABLE>name</VARIABLE><PUNCTUATION>:</PUNCTUATION> John<PUNCTUATION>,</PUNCTUATION> <VARIABLE>age</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>30</NUMBER><PUNCTUATION>}</PUNCTUATION>

<VARIABLE>nested_map</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <VARIABLE>level1</VARIABLE><PUNCTUATION>:</PUNCTUATION>
    <VARIABLE>level2</VARIABLE><PUNCTUATION>:</PUNCTUATION>
      <VARIABLE>level3</VARIABLE><PUNCTUATION>:</PUNCTUATION> deep_value

<COMMENT># Anchors and aliases</COMMENT>
<VARIABLE>defaults</VARIABLE><PUNCTUATION>:</PUNCTUATION> <ATTRIBUTE>&defaults</ATTRIBUTE>
  <VARIABLE>adapter</VARIABLE><PUNCTUATION>:</PUNCTUATION> postgres
  <VARIABLE>host</VARIABLE><PUNCTUATION>:</PUNCTUATION> localhost
  <VARIABLE>port</VARIABLE><PUNCTUATION>:</PUNCTUATION> <NUMBER>5432</NUMBER>

<VARIABLE>development</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <<<PUNCTUATION>:</PUNCTUATION> <VARIABLE>*defaults</VARIABLE>
  <VARIABLE>database</VARIABLE><PUNCTUATION>:</PUNCTUATION> dev_db

<VARIABLE>production</VARIABLE><PUNCTUATION>:</PUNCTUATION>
  <<<PUNCTUATION>:</PUNCTUATION> <VARIABLE>*defaults</VARIABLE>
  <VARIABLE>database</VARIABLE><PUNCTUATION>:</PUNCTUATION> prod_db
  <VARIABLE>host</VARIABLE><PUNCTUATION>:</PUNCTUATION> prod.example.com

<COMMENT># Complex keys</COMMENT>
? <PUNCTUATION>-</PUNCTUATION> key
  <PUNCTUATION>-</PUNCTUATION> with
  <PUNCTUATION>-</PUNCTUATION> list
<PUNCTUATION>:</PUNCTUATION> complex_key_value

<COMMENT># Tags</COMMENT>
<VARIABLE>explicit_string</VARIABLE><PUNCTUATION>:</PUNCTUATION> <TYPE>!!str</TYPE> <NUMBER>123</NUMBER>
<VARIABLE>explicit_int</VARIABLE><PUNCTUATION>:</PUNCTUATION> <TYPE>!!int</TYPE> <STRING>"456"</STRING>
<VARIABLE>explicit_float</VARIABLE><PUNCTUATION>:</PUNCTUATION> <TYPE>!!float</TYPE> <STRING>"3.14"</STRING>
<VARIABLE>binary</VARIABLE><PUNCTUATION>:</PUNCTUATION> <TYPE>!!binary</TYPE> <OPERATOR>|</OPERATOR>
  R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA<NUMBER>7</NUMBER>

<COMMENT># Timestamps</COMMENT>
<VARIABLE>datetime</VARIABLE><PUNCTUATION>:</PUNCTUATION> 2024<PUNCTUATION>-</PUNCTUATION>01<PUNCTUATION>-</PUNCTUATION>15<VARIABLE>T10</VARIABLE><PUNCTUATION>:</PUNCTUATION>30<PUNCTUATION>:</PUNCTUATION>00Z
<VARIABLE>date</VARIABLE><PUNCTUATION>:</PUNCTUATION> 2024<PUNCTUATION>-</PUNCTUATION>01<NUMBER>-15</NUMBER>
<VARIABLE>time_with_offset</VARIABLE><PUNCTUATION>:</PUNCTUATION> 2024<PUNCTUATION>-</PUNCTUATION>01<PUNCTUATION>-</PUNCTUATION>15<VARIABLE>T10</VARIABLE><PUNCTUATION>:</PUNCTUATION>30<PUNCTUATION>:</PUNCTUATION>00+05<PUNCTUATION>:</PUNCTUATION><NUMBER>30</NUMBER>

<COMMENT># Environment variables (common pattern)</COMMENT>
<VARIABLE>database_url</VARIABLE><PUNCTUATION>:</PUNCTUATION> $<PUNCTUATION>{</PUNCTUATION>DATABASE_URL<PUNCTUATION>}</PUNCTUATION>
<VARIABLE>api_key</VARIABLE><PUNCTUATION>:</PUNCTUATION> $<PUNCTUATION>{</PUNCTUATION><VARIABLE>API_KEY</VARIABLE><PUNCTUATION>:</PUNCTUATION><PUNCTUATION>-</PUNCTUATION>default_key<PUNCTUATION>}</PUNCTUATION>

<COMMENT># Special characters in strings</COMMENT>
<VARIABLE>special</VARIABLE><PUNCTUATION>:</PUNCTUATION> <STRING>"Contains: colons, {braces}, [brackets], and #hash"</STRING>
