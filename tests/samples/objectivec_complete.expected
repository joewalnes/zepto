        <COMMENT>// Numbers</COMMENT>
        <TYPE>int</TYPE> integer <OPERATOR>=</OPERATOR> <NUMBER>42</NUMBER>;
        <TYPE>long</TYPE> long<TYPE>Val</TYPE> <OPERATOR>=</OPERATOR> <NUMBER>42L</NUMBER>;
        <TYPE>float</TYPE> float<TYPE>Val</TYPE> <OPERATOR>=</OPERATOR> <NUMBER>3.14f</NUMBER>;
        <TYPE>double</TYPE> double<TYPE>Val</TYPE> <OPERATOR>=</OPERATOR> <NUMBER>3.14</NUMBER>;
        <TYPE>CGFloat</TYPE> cg<TYPE>Float</TYPE> <OPERATOR>=</OPERATOR> <NUMBER>10.0</NUMBER>;

        <KEYWORD>return</KEYWORD> <NUMBER>0</NUMBER>;
    }
}
