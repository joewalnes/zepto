   <ATTRIBUTE>:align:</ATTRIBUTE><STRING> center</STRING>

<PUNCTUATION>.. </PUNCTUATION><KEYWORD>table</KEYWORD><PUNCTUATION>::</PUNCTUATION><STRING> Comparison Table</STRING>
   <ATTRIBUTE>:widths:</ATTRIBUTE><STRING> auto</STRING>

