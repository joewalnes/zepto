<FUNCTION>#!/bin/bash</FUNCTION>
<FUNCTION>echo "Installing..."</FUNCTION>
<FUNCTION>sudo apt-get update</FUNCTION>
<FUNCTION>sudo apt-get install -y mypackage</FUNCTION>
<PUNCTUATION>----</PUNCTUATION>

