  <KEYWORD>-</KEYWORD> Nested item 2.2
    <KEYWORD>-</KEYWORD> Deeply nested 2.2.1
<KEYWORD>-</KEYWORD> Item 3

<KEYWORD>*</KEYWORD> Alternative marker 1
<KEYWORD>*</KEYWORD> Alternative marker 2

<KEYWORD>+</KEYWORD> Another marker 1
<KEYWORD>+</KEYWORD> Another marker 2

<PUNCTUATION>###</PUNCTUATION> <HEADING3>Ordered Lists</HEADING3>

<KEYWORD>1.</KEYWORD> First item
<KEYWORD>2.</KEYWORD> Second item
   <KEYWORD>1.</KEYWORD> Nested 2.1
   <KEYWORD>2.</KEYWORD> Nested 2.2
<KEYWORD>3.</KEYWORD> Third item

1) Alternative style 1
2) Alternative style 2

<PUNCTUATION>###</PUNCTUATION> <HEADING3>Task Lists</HEADING3>

<KEYWORD>-</KEYWORD> [x] Completed task
<KEYWORD>-</KEYWORD> [ ] Incomplete task
<KEYWORD>-</KEYWORD> [x] Another completed task
  <KEYWORD>-</KEYWORD> [ ] Nested incomplete
  <KEYWORD>-</KEYWORD> [x] Nested complete

