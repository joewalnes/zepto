# Expected syntax highlighting for ini_complete.ini
# Generated from INI grammar
# Format: <TYPE>text</TYPE> where TYPE is the token type

<COMMENT># INI sample file demonstrating syntax features</COMMENT>
<COMMENT># This is a comment using hash</COMMENT>

<COMMENT>; This is also a comment using semicolon</COMMENT>

<PUNCTUATION>[</PUNCTUATION><TYPE>general</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>name</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>MyApplication</STRING>
<VARIABLE>version</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>1.0</NUMBER><NUMBER>.0</NUMBER>
<VARIABLE>debug</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>true</KEYWORD>
<VARIABLE>verbose</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>false</KEYWORD>

<PUNCTUATION>[</PUNCTUATION><TYPE>database</TYPE><PUNCTUATION>]</PUNCTUATION>
<COMMENT>; Database connection settings</COMMENT>
<VARIABLE>host</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>localhost</STRING>
<VARIABLE>port</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>5432</NUMBER>
<VARIABLE>name</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>myapp_db</STRING>
<VARIABLE>user</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>dbuser</STRING>
<VARIABLE>password</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>"secret password with spaces"</STRING>

<PUNCTUATION>[</PUNCTUATION><TYPE>database.pool</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>min_connections</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>5</NUMBER>
<VARIABLE>max_connections</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>20</NUMBER>
<VARIABLE>timeout</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>30.5</NUMBER>

<PUNCTUATION>[</PUNCTUATION><TYPE>server</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>host</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>0.0</NUMBER><NUMBER>.0</NUMBER><NUMBER>.0</NUMBER>
<VARIABLE>port</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>8080</NUMBER>
<VARIABLE>workers</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>4</NUMBER>
<VARIABLE>ssl_enabled</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>yes</KEYWORD>  <COMMENT>; Boolean as yes/no</COMMENT>
<VARIABLE>keepalive</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>on</KEYWORD>     <COMMENT>; Boolean as on/off</COMMENT>

<PUNCTUATION>[</PUNCTUATION><TYPE>paths</TYPE><PUNCTUATION>]</PUNCTUATION>
<COMMENT>; File paths</COMMENT>
<VARIABLE>data_dir</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>/var/lib/myapp/data</STRING>
<VARIABLE>log_file</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>/var/log/myapp/app.log</STRING>
<VARIABLE>temp_dir</VARIABLE> <OPERATOR>=</OPERATOR> <VARIABLE>${TEMP}</VARIABLE><STRING>/myapp</STRING>

<PUNCTUATION>[</PUNCTUATION><TYPE>logging</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>level</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>INFO</STRING>
<VARIABLE>format</VARIABLE> <OPERATOR>=</OPERATOR> <VARIABLE>%(asctime)s</VARIABLE><STRING> - %(name)s - %(levelname)s - %(message)s</STRING>
<VARIABLE>file</VARIABLE> <OPERATOR>=</OPERATOR> <VARIABLE>${paths:log_file}</VARIABLE>
<VARIABLE>max_size</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>10485760</NUMBER>
<VARIABLE>backup_count</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>5</NUMBER>

<PUNCTUATION>[</PUNCTUATION><TYPE>cache</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>enabled</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>true</KEYWORD>
<VARIABLE>type</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>redis</STRING>
<VARIABLE>host</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>127.0</NUMBER><NUMBER>.0</NUMBER><NUMBER>.1</NUMBER>
<VARIABLE>port</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>6379</NUMBER>
<VARIABLE>ttl</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>3600</NUMBER>
<VARIABLE>prefix</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>myapp:</STRING>

<PUNCTUATION>[</PUNCTUATION><TYPE>email</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>smtp_host</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>smtp.example.com</STRING>
<VARIABLE>smtp_port</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>587</NUMBER>
<VARIABLE>smtp_user</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>noreply@example.com</STRING>
<VARIABLE>smtp_password</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>"email_password"</STRING>
<VARIABLE>use_tls</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>true</KEYWORD>
<VARIABLE>from_address</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>"MyApp &lt;noreply@example.com&gt;"</STRING>

<PUNCTUATION>[</PUNCTUATION><TYPE>features</TYPE><PUNCTUATION>]</PUNCTUATION>
<COMMENT>; Feature flags</COMMENT>
<VARIABLE>new_ui</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>false</KEYWORD>
<VARIABLE>beta_features</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>true</KEYWORD>
<VARIABLE>experimental</VARIABLE> <OPERATOR>=</OPERATOR> <KEYWORD>no</KEYWORD>

<PUNCTUATION>[</PUNCTUATION><TYPE>limits</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>max_upload_size</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>52428800</NUMBER>
<VARIABLE>max_requests_per_minute</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>100</NUMBER>
<VARIABLE>session_timeout</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>1800</NUMBER>

<PUNCTUATION>[</PUNCTUATION><TYPE>api</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>base_url</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>https://api.example.com/v1</STRING>
<VARIABLE>api_key</VARIABLE> <OPERATOR>=</OPERATOR> <VARIABLE>${API_KEY}</VARIABLE>
<VARIABLE>timeout</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>30</NUMBER>
<VARIABLE>retry_count</VARIABLE> <OPERATOR>=</OPERATOR> <NUMBER>3</NUMBER>

<PUNCTUATION>[</PUNCTUATION><TYPE>internationalization</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>default_language</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>en</STRING>
<VARIABLE>supported_languages</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>en,es,fr,de,ja</STRING>
<VARIABLE>fallback</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>en</STRING>

<COMMENT>; Empty section</COMMENT>
<PUNCTUATION>[</PUNCTUATION><TYPE>empty_section</TYPE><PUNCTUATION>]</PUNCTUATION>

<PUNCTUATION>[</PUNCTUATION><TYPE>special.characters</TYPE><PUNCTUATION>]</PUNCTUATION>
<VARIABLE>path_with_spaces</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>"C:\Program Files\MyApp"</STRING>
<VARIABLE>url</VARIABLE> <OPERATOR>=</OPERATOR> <STRING>https://example.com/path?query=value&amp;other=123</STRING>
