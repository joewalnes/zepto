    <KEYWORD>return</KEYWORD> <FUNCTION>setmetatable</FUNCTION>({x <OPERATOR>=</OPERATOR> x, y <OPERATOR>=</OPERATOR> y}, Vect<KEYWORD>or</KEYWORD>)
