<COMMENT>-- Metatables</COMMENT>
<KEYWORD>local</KEYWORD> Vect<KEYWORD>or</KEYWORD> <OPERATOR>=</OPERATOR> {}
Vect<KEYWORD>or</KEYWORD>.__index <OPERATOR>=</OPERATOR> Vect<KEYWORD>or</KEYWORD>

