    <KEYWORD>const</KEYWORD> <TYPE>T</TYPE><OPERATOR>&</OPERATOR> <KEYWORD>operator</KEYWORD>[](<TYPE>size_t</TYPE> index) <KEYWORD>const</KEYWORD> {
