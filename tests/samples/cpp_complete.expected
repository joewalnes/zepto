    <FUNCTION>Container</FUNCTION>(<TYPE>Container</TYPE><OPERATOR>&&</OPERATOR> other) <KEYWORD>noexcept</KEYWORD> <OPERATOR>=</OPERATOR> <KEYWORD>default</KEYWORD>;
    <TYPE>Container</TYPE><OPERATOR>&</OPERATOR> <KEYWORD>operator</KEYWORD><OPERATOR>=</OPERATOR>(<KEYWORD>const</KEYWORD> <TYPE>Container</TYPE><OPERATOR>&</OPERATOR> other) <OPERATOR>=</OPERATOR> <KEYWORD>default</KEYWORD>;
    <TYPE>Container</TYPE><OPERATOR>&</OPERATOR> <KEYWORD>operator</KEYWORD><OPERATOR>=</OPERATOR>(<TYPE>Container</TYPE><OPERATOR>&&</OPERATOR> other) <KEYWORD>noexcept</KEYWORD> <OPERATOR>=</OPERATOR> <KEYWORD>default</KEYWORD>;

    <KEYWORD>void</KEYWORD> <FUNCTION>add</FUNCTION>(<KEYWORD>const</KEYWORD> <TYPE>T</TYPE><OPERATOR>&</OPERATOR> item) {
