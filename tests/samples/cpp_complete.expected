    <TYPE>std::</TYPE><TYPE>shared_ptr</TYPE><OPERATOR><</OPERATOR><TYPE>Shape</TYPE><OPERATOR>></OPERATOR> shape <OPERATOR>=</OPERATOR> <TYPE>std::</TYPE><FUNCTION>make_shared</FUNCTION><OPERATOR><</OPERATOR><TYPE>Circle</TYPE><OPERATOR>></OPERATOR>(<NUMBER>3.0</NUMBER>);

