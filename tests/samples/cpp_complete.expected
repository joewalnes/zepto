    }

    <KEYWORD>void</KEYWORD> <FUNCTION>add</FUNCTION>(<TYPE>T</TYPE><OPERATOR>&&</OPERATOR> item) {
        items_.<FUNCTION>push_back</FUNCTION>(<TYPE>std::</TYPE><FUNCTION>move</FUNCTION>(item));
