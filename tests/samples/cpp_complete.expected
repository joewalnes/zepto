<COMMENT>// Function template</COMMENT>
<KEYWORD>template</KEYWORD><OPERATOR><</OPERATOR><KEYWORD>typename</KEYWORD> <TYPE>T</TYPE><OPERATOR>></OPERATOR>
<TYPE>T</TYPE> <FUNCTION>max_value</FUNCTION>(<TYPE>T</TYPE> a, <TYPE>T</TYPE> b) {
