        <TAG></product></TAG>

        <TAG><product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"003"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"accessories"</STRING><TAG>></TAG>
