            <TAG></reviews></TAG>
        <TAG></product></TAG>

        <TAG><product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"002"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"computers"</STRING> <ATTRIBUTE>featured</ATTRIBUTE>=<STRING>"false"</STRING><TAG>></TAG>
            <TAG><name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"en"</STRING><TAG>></TAG>Laptop Stand<TAG></name></TAG>
