        <TAG></product></TAG>
    <TAG></products></TAG>

    <COMMENT><!-- Nested structure with mixed content --></COMMENT>
    <TAG><documentation</TAG><TAG>></TAG>
        <TAG><chapter</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"ch1"</STRING> <ATTRIBUTE>title</ATTRIBUTE>=<STRING>"Getting Started"</STRING><TAG>></TAG>
            <TAG><para</TAG><TAG>></TAG>Welcome to the <TAG><emphasis</TAG><TAG>></TAG>product catalog<TAG></emphasis></TAG> system.<TAG></para></TAG>
