&lt;?xml-stylesheet type="text/xsl" href="transform.xsl"?&gt;
<KEYWORD>&lt;!DOCTYPE catalog SYSTEM "catalog.dtd"&gt;</KEYWORD>
<COMMENT>&lt;!--</COMMENT>
<COMMENT>  Complete XML Example</COMMENT>
<COMMENT>  Demonstrating various XML syntax elements</COMMENT>
<COMMENT>--&gt;</COMMENT>
&lt;catalog xmlns="http://example.com/catalog"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xsi:schemaLocation="http://example.com/catalog catalog.xsd"&gt;

    <COMMENT>&lt;!-- Simple elements --&gt;</COMMENT>
    <TAG>&lt;title</TAG><TAG>&gt;</TAG>Product Catalog<TAG>&lt;/title&gt;</TAG>
    <TAG>&lt;description</TAG><TAG>&gt;</TAG>A comprehensive list of products<TAG>&lt;/description&gt;</TAG>
    <TAG>&lt;version</TAG><TAG>&gt;</TAG>2.0<TAG>&lt;/version&gt;</TAG>
    <TAG>&lt;lastUpdated</TAG><TAG>&gt;</TAG>2024-01-15T10:30:00Z<TAG>&lt;/lastUpdated&gt;</TAG>

    <COMMENT>&lt;!-- Element with attributes --&gt;</COMMENT>
    <TAG>&lt;metadata</TAG> <ATTRIBUTE>author</ATTRIBUTE>=<STRING>"John Doe"</STRING> <ATTRIBUTE>created</ATTRIBUTE>=<STRING>"2024-01-01"</STRING> <ATTRIBUTE>status</ATTRIBUTE>=<STRING>"active"</STRING><TAG>&gt;</TAG>
        <TAG>&lt;dc:creator</TAG><TAG>&gt;</TAG>John Doe<TAG>&lt;/dc:creator&gt;</TAG>
        <TAG>&lt;dc:publisher</TAG><TAG>&gt;</TAG>Example Corp<TAG>&lt;/dc:publisher&gt;</TAG>
        <TAG>&lt;dc:rights</TAG><TAG>&gt;</TAG>Copyright 2024<TAG>&lt;/dc:rights&gt;</TAG>
    <TAG>&lt;/metadata&gt;</TAG>

    <COMMENT>&lt;!-- CDATA section --&gt;</COMMENT>
    <TAG>&lt;script</TAG><TAG>&gt;</TAG><OPERATOR>&lt;</OPERATOR><OPERATOR>!</OPERATOR>[<CONSTANT>CDATA</CONSTANT>[
        <KEYWORD>function</KEYWORD> <FUNCTION>process</FUNCTION>(data) {
            <KEYWORD>if</KEYWORD> (<FUNCTION>data</FUNCTION> <OPERATOR>&lt;</OPERATOR> <NUMBER>10</NUMBER> <OPERATOR>&amp;&amp;</OPERATOR> data <OPERATOR>&gt;</OPERATOR> <NUMBER>0</NUMBER>) {
                <KEYWORD>return</KEYWORD> data <OPERATOR>*</OPERATOR> <NUMBER>2</NUMBER>;
            }
            <KEYWORD>return</KEYWORD> data;
        }
    ]]<OPERATOR>&gt;</OPERATOR><TAG>&lt;/script&gt;</TAG>

    <COMMENT>&lt;!-- Products list --&gt;</COMMENT>
    <TAG>&lt;products</TAG> <ATTRIBUTE>count</ATTRIBUTE>=<STRING>"3"</STRING><TAG>&gt;</TAG>
        <TAG>&lt;product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"001"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"electronics"</STRING> <ATTRIBUTE>featured</ATTRIBUTE>=<STRING>"true"</STRING><TAG>&gt;</TAG>
            <TAG>&lt;name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"en"</STRING><TAG>&gt;</TAG>Wireless Headphones<TAG>&lt;/name&gt;</TAG>
            <TAG>&lt;name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"es"</STRING><TAG>&gt;</TAG>Auriculares Inalámbricos<TAG>&lt;/name&gt;</TAG>
            <TAG>&lt;price</TAG> <ATTRIBUTE>currency</ATTRIBUTE>=<STRING>"USD"</STRING><TAG>&gt;</TAG>99.99<TAG>&lt;/price&gt;</TAG>
            <TAG>&lt;price</TAG> <ATTRIBUTE>currency</ATTRIBUTE>=<STRING>"EUR"</STRING><TAG>&gt;</TAG>89.99<TAG>&lt;/price&gt;</TAG>
            <TAG>&lt;stock</TAG><TAG>&gt;</TAG>150<TAG>&lt;/stock&gt;</TAG>
            <TAG>&lt;description</TAG><TAG>&gt;</TAG>
                High-quality wireless headphones with
                noise cancellation <CONSTANT>&amp;amp;</CONSTANT> long battery life.
                Special chars: <CONSTANT>&amp;lt;</CONSTANT>tag<CONSTANT>&amp;gt;</CONSTANT> <CONSTANT>&amp;quot;</CONSTANT>quoted<CONSTANT>&amp;quot;</CONSTANT> <CONSTANT>&amp;apos;</CONSTANT>apostrophe<CONSTANT>&amp;apos;</CONSTANT>
            <TAG>&lt;/description&gt;</TAG>
            <TAG>&lt;specifications</TAG><TAG>&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"battery"</STRING><TAG>&gt;</TAG>30 hours<TAG>&lt;/spec&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"weight"</STRING><TAG>&gt;</TAG>250g<TAG>&lt;/spec&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"connectivity"</STRING><TAG>&gt;</TAG>Bluetooth 5.0<TAG>&lt;/spec&gt;</TAG>
            <TAG>&lt;/specifications&gt;</TAG>
            <TAG>&lt;tags</TAG><TAG>&gt;</TAG>
                <TAG>&lt;tag</TAG><TAG>&gt;</TAG>audio<TAG>&lt;/tag&gt;</TAG>
                <TAG>&lt;tag</TAG><TAG>&gt;</TAG>wireless<TAG>&lt;/tag&gt;</TAG>
                <TAG>&lt;tag</TAG><TAG>&gt;</TAG>bluetooth<TAG>&lt;/tag&gt;</TAG>
            <TAG>&lt;/tags&gt;</TAG>
            <TAG>&lt;reviews</TAG><TAG>&gt;</TAG>
                <TAG>&lt;review</TAG> <ATTRIBUTE>rating</ATTRIBUTE>=<STRING>"5"</STRING> <ATTRIBUTE>verified</ATTRIBUTE>=<STRING>"true"</STRING><TAG>&gt;</TAG>
                    <TAG>&lt;author</TAG><TAG>&gt;</TAG>Alice<TAG>&lt;/author&gt;</TAG>
                    <TAG>&lt;date</TAG><TAG>&gt;</TAG>2024-01-10<TAG>&lt;/date&gt;</TAG>
                    <TAG>&lt;content</TAG><TAG>&gt;</TAG>Excellent sound quality!<TAG>&lt;/content&gt;</TAG>
                <TAG>&lt;/review&gt;</TAG>
                <TAG>&lt;review</TAG> <ATTRIBUTE>rating</ATTRIBUTE>=<STRING>"4"</STRING> <ATTRIBUTE>verified</ATTRIBUTE>=<STRING>"false"</STRING><TAG>&gt;</TAG>
                    <TAG>&lt;author</TAG><TAG>&gt;</TAG>Bob<TAG>&lt;/author&gt;</TAG>
                    <TAG>&lt;date</TAG><TAG>&gt;</TAG>2024-01-12<TAG>&lt;/date&gt;</TAG>
                    <TAG>&lt;content</TAG><TAG>&gt;</TAG>Good value for money.<TAG>&lt;/content&gt;</TAG>
                <TAG>&lt;/review&gt;</TAG>
            <TAG>&lt;/reviews&gt;</TAG>
        <TAG>&lt;/product&gt;</TAG>

        <TAG>&lt;product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"002"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"computers"</STRING> <ATTRIBUTE>featured</ATTRIBUTE>=<STRING>"false"</STRING><TAG>&gt;</TAG>
            <TAG>&lt;name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"en"</STRING><TAG>&gt;</TAG>Laptop Stand<TAG>&lt;/name&gt;</TAG>
            <TAG>&lt;price</TAG> <ATTRIBUTE>currency</ATTRIBUTE>=<STRING>"USD"</STRING><TAG>&gt;</TAG>49.99<TAG>&lt;/price&gt;</TAG>
            <TAG>&lt;stock</TAG><TAG>&gt;</TAG>300<TAG>&lt;/stock&gt;</TAG>
            <TAG>&lt;description</TAG><TAG>&gt;</TAG>Ergonomic aluminum laptop stand.<TAG>&lt;/description&gt;</TAG>
            <TAG>&lt;specifications</TAG><TAG>&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"material"</STRING><TAG>&gt;</TAG>Aluminum<TAG>&lt;/spec&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"weight"</STRING><TAG>&gt;</TAG>500g<TAG>&lt;/spec&gt;</TAG>
                <TAG>&lt;spec</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"compatibility"</STRING><TAG>&gt;</TAG>All laptops up to 17"<TAG>&lt;/spec&gt;</TAG>
            <TAG>&lt;/specifications&gt;</TAG>
            <COMMENT>&lt;!-- Empty element --&gt;</COMMENT>
            <TAG>&lt;tags</TAG><TAG>/&gt;</TAG>
        <TAG>&lt;/product&gt;</TAG>

        <TAG>&lt;product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"003"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"accessories"</STRING><TAG>&gt;</TAG>
            <TAG>&lt;name</TAG><TAG>&gt;</TAG>USB-C Hub<TAG>&lt;/name&gt;</TAG>
            <TAG>&lt;price</TAG> <ATTRIBUTE>currency</ATTRIBUTE>=<STRING>"USD"</STRING> <ATTRIBUTE>discount</ATTRIBUTE>=<STRING>"10%"</STRING><TAG>&gt;</TAG>79.99<TAG>&lt;/price&gt;</TAG>
            <TAG>&lt;stock</TAG><TAG>&gt;</TAG>0<TAG>&lt;/stock&gt;</TAG>
            <TAG>&lt;availability</TAG> <ATTRIBUTE>status</ATTRIBUTE>=<STRING>"out-of-stock"</STRING> <ATTRIBUTE>restock-date</ATTRIBUTE>=<STRING>"2024-02-01"</STRING><TAG>/&gt;</TAG>
            <TAG>&lt;description</TAG><TAG>&gt;</TAG>Multi-port USB-C hub with HDMI output.<TAG>&lt;/description&gt;</TAG>
        <TAG>&lt;/product&gt;</TAG>
    <TAG>&lt;/products&gt;</TAG>

    <COMMENT>&lt;!-- Nested structure with mixed content --&gt;</COMMENT>
    <TAG>&lt;documentation</TAG><TAG>&gt;</TAG>
        <TAG>&lt;chapter</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"ch1"</STRING> <ATTRIBUTE>title</ATTRIBUTE>=<STRING>"Getting Started"</STRING><TAG>&gt;</TAG>
            <TAG>&lt;para</TAG><TAG>&gt;</TAG>Welcome to the <TAG>&lt;emphasis</TAG><TAG>&gt;</TAG>product catalog<TAG>&lt;/emphasis&gt;</TAG> system.<TAG>&lt;/para&gt;</TAG>
            <TAG>&lt;para</TAG><TAG>&gt;</TAG>This document contains <TAG>&lt;link</TAG> <ATTRIBUTE>href</ATTRIBUTE>=<STRING>"#ch2"</STRING><TAG>&gt;</TAG>important information<TAG>&lt;/link&gt;</TAG>.<TAG>&lt;/para&gt;</TAG>
            <TAG>&lt;note</TAG> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"warning"</STRING><TAG>&gt;</TAG>
                Please read all instructions carefully.
            <TAG>&lt;/note&gt;</TAG>
        <TAG>&lt;/chapter&gt;</TAG>
        <TAG>&lt;chapter</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"ch2"</STRING> <ATTRIBUTE>title</ATTRIBUTE>=<STRING>"Advanced Usage"</STRING><TAG>&gt;</TAG>
            <TAG>&lt;para</TAG><TAG>&gt;</TAG>For advanced users:<TAG>&lt;/para&gt;</TAG>
            <TAG>&lt;list</TAG> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"ordered"</STRING><TAG>&gt;</TAG>
                <TAG>&lt;item</TAG><TAG>&gt;</TAG>Configure settings<TAG>&lt;/item&gt;</TAG>
                <TAG>&lt;item</TAG><TAG>&gt;</TAG>Import data<TAG>&lt;/item&gt;</TAG>
                <TAG>&lt;item</TAG><TAG>&gt;</TAG>Run reports<TAG>&lt;/item&gt;</TAG>
            <TAG>&lt;/list&gt;</TAG>
        <TAG>&lt;/chapter&gt;</TAG>
    <TAG>&lt;/documentation&gt;</TAG>

    <COMMENT>&lt;!-- Processing instructions --&gt;</COMMENT>
    &lt;?custom-processor option="value"?&gt;

    <COMMENT>&lt;!-- Numeric and boolean values --&gt;</COMMENT>
    <TAG>&lt;settings</TAG><TAG>&gt;</TAG>
        <TAG>&lt;setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"maxItems"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"integer"</STRING><TAG>&gt;</TAG>100<TAG>&lt;/setting&gt;</TAG>
        <TAG>&lt;setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"threshold"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"decimal"</STRING><TAG>&gt;</TAG>0.75<TAG>&lt;/setting&gt;</TAG>
        <TAG>&lt;setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"enabled"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"boolean"</STRING><TAG>&gt;</TAG>true<TAG>&lt;/setting&gt;</TAG>
        <TAG>&lt;setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"disabled"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"boolean"</STRING><TAG>&gt;</TAG>false<TAG>&lt;/setting&gt;</TAG>
        <TAG>&lt;setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"empty"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"null"</STRING><TAG>/&gt;</TAG>
    <TAG>&lt;/settings&gt;</TAG>

<TAG>&lt;/catalog&gt;</TAG>
