        <TAG><setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"enabled"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"boolean"</STRING><TAG>></TAG>true<TAG></setting></TAG>
        <TAG><setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"disabled"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"boolean"</STRING><TAG>></TAG>false<TAG></setting></TAG>
        <TAG><setting</TAG> <ATTRIBUTE>name</ATTRIBUTE>=<STRING>"empty"</STRING> <ATTRIBUTE>type</ATTRIBUTE>=<STRING>"null"</STRING><TAG>/></TAG>
