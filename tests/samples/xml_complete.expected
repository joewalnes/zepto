    <COMMENT><!-- Simple elements --></COMMENT>
    <TAG><title</TAG><TAG>></TAG>Product Catalog<TAG></title></TAG>
    <TAG><description</TAG><TAG>></TAG>A comprehensive list of products<TAG></description></TAG>
    <TAG><version</TAG><TAG>></TAG>2.0<TAG></version></TAG>
    <TAG><lastUpdated</TAG><TAG>></TAG>2024-01-15T10:30:00Z<TAG></lastUpdated></TAG>

    <COMMENT><!-- Element with attributes --></COMMENT>
    <TAG><metadata</TAG> <ATTRIBUTE>author</ATTRIBUTE>=<STRING>"John Doe"</STRING> <ATTRIBUTE>created</ATTRIBUTE>=<STRING>"2024-01-01"</STRING> <ATTRIBUTE>status</ATTRIBUTE>=<STRING>"active"</STRING><TAG>></TAG>
        <TAG><dc:creator</TAG><TAG>></TAG>John Doe<TAG></dc:creator></TAG>
        <TAG><dc:publisher</TAG><TAG>></TAG>Example Corp<TAG></dc:publisher></TAG>
        <TAG><dc:rights</TAG><TAG>></TAG>Copyright 2024<TAG></dc:rights></TAG>
    <TAG></metadata></TAG>

    <COMMENT><!-- CDATA section --></COMMENT>
    <TAG><script</TAG><TAG>></TAG><![CDATA[
<FUNCTION>        function process(data) {</FUNCTION>
<FUNCTION>            if (data < 10 && data > 0) {</FUNCTION>
<FUNCTION>                return data * 2;</FUNCTION>
<FUNCTION>            }</FUNCTION>
<FUNCTION>            return data;</FUNCTION>
<FUNCTION>        }</FUNCTION>
<FUNCTION>    ]]></FUNCTION><TAG></script></TAG>

    <COMMENT><!-- Products list --></COMMENT>
    <TAG><products</TAG> <ATTRIBUTE>count</ATTRIBUTE>=<STRING>"3"</STRING><TAG>></TAG>
        <TAG><product</TAG> <ATTRIBUTE>id</ATTRIBUTE>=<STRING>"001"</STRING> <ATTRIBUTE>category</ATTRIBUTE>=<STRING>"electronics"</STRING> <ATTRIBUTE>featured</ATTRIBUTE>=<STRING>"true"</STRING><TAG>></TAG>
            <TAG><name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"en"</STRING><TAG>></TAG>Wireless Headphones<TAG></name></TAG>
            <TAG><name</TAG> <ATTRIBUTE>lang</ATTRIBUTE>=<STRING>"es"</STRING><TAG>></TAG>Auriculares Inalámbricos<TAG></name></TAG>
