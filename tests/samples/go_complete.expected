	fmt.<FUNCTION>Printf</FUNCTION>(<STRING>"Point: %+v\n"</STRING>, po<TYPE>int</TYPE>)

	<COMMENT>// Type assertion</COMMENT>
	<KEYWORD>var</KEYWORD> reader io.<TYPE>Reader</TYPE>
	<KEYWORD>if</KEYWORD> closer, ok <OPERATOR>:=</OPERATOR> reader.(io.<TYPE>Closer</TYPE>); ok {
		<KEYWORD>defer</KEYWORD> closer.<FUNCTION>Close</FUNCTION>()
