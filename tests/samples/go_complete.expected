	ch <OPERATOR>:=</OPERATOR> <FUNCTION>make</FUNCTION>(<KEYWORD>chan</KEYWORD> <TYPE>int</TYPE>, <NUMBER>10</NUMBER>)
	<KEYWORD>go</KEYWORD> <KEYWORD>func</KEYWORD>() {
		<KEYWORD>for</KEYWORD> _, n <OPERATOR>:=</OPERATOR> <KEYWORD>range</KEYWORD> numbers {
			ch <OPERATOR><-</OPERATOR> n
		}
		<FUNCTION>close</FUNCTION>(ch)
	}()

	<KEYWORD>for</KEYWORD> n <OPERATOR>:=</OPERATOR> <KEYWORD>range</KEYWORD> ch {
		fmt.<FUNCTION>Println</FUNCTION>(n)
	}

	<COMMENT>// Anonymous struct</COMMENT>
