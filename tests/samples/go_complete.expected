<COMMENT>// Method on generic type</COMMENT>
<KEYWORD>func</KEYWORD> (s *Stack[T]) <FUNCTION>Push</FUNCTION>(item <TYPE>T</TYPE>) {
	s.mu.<FUNCTION>Lock</FUNCTION>()
	<KEYWORD>defer</KEYWORD> s.mu.<FUNCTION>Unlock</FUNCTION>()
	s.items <OPERATOR>=</OPERATOR> <FUNCTION>append</FUNCTION>(s.items, item)
}

<KEYWORD>func</KEYWORD> (s *Stack[T]) <FUNCTION>Pop</FUNCTION>() (<TYPE>T</TYPE>, <TYPE>bool</TYPE>) {
	s.mu.<FUNCTION>Lock</FUNCTION>()
	<KEYWORD>defer</KEYWORD> s.mu.<FUNCTION>Unlock</FUNCTION>()
	<KEYWORD>var</KEYWORD> zero <TYPE>T</TYPE>
	<KEYWORD>if</KEYWORD> <FUNCTION>len</FUNCTION>(s.items) <OPERATOR>==</OPERATOR> <NUMBER>0</NUMBER> {
		<KEYWORD>return</KEYWORD> zero, <KEYWORD>false</KEYWORD>
	}
	item <OPERATOR>:=</OPERATOR> s.items[<FUNCTION>len</FUNCTION>(s.items)<OPERATOR>-</OPERATOR><NUMBER>1</NUMBER>]
	s.items <OPERATOR>=</OPERATOR> s.items[:<FUNCTION>len</FUNCTION>(s.items)<OPERATOR>-</OPERATOR><NUMBER>1</NUMBER>]
	<KEYWORD>return</KEYWORD> item, <KEYWORD>true</KEYWORD>
}

