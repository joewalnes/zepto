	}()

	<COMMENT>// Defer, panic, recover</COMMENT>
	<KEYWORD>defer</KEYWORD> <KEYWORD>func</KEYWORD>() {
		<KEYWORD>if</KEYWORD> r <OPERATOR>:=</OPERATOR> <FUNCTION>recover</FUNCTION>(); r <OPERATOR>!=</OPERATOR> <KEYWORD>nil</KEYWORD> {
			fmt.<FUNCTION>Println</FUNCTION>(<STRING>"Recovered:"</STRING>, r)
		}
	}()

