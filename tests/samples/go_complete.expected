	numbers <OPERATOR>:=</OPERATOR> []<TYPE>int</TYPE>{<NUMBER>10</NUMBER>, <NUMBER>20</NUMBER>, <NUMBER>30</NUMBER>}

	<COMMENT>// Map literal</COMMENT>
