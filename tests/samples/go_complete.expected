<COMMENT>// Named return values</COMMENT>
<KEYWORD>func</KEYWORD> <FUNCTION>minMax</FUNCTION>(numbers []<TYPE>int</TYPE>) (min, max <TYPE>int</TYPE>) {
	<KEYWORD>if</KEYWORD> <FUNCTION>len</FUNCTION>(numbers) <OPERATOR>==</OPERATOR> <NUMBER>0</NUMBER> {
