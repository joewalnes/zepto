        <KEYWORD>@media</KEYWORD> <PUNCTUATION>(</PUNCTUATION><VARIABLE>min-width</VARIABLE><PUNCTUATION>:</PUNCTUATION> <VARIABLE>$breakpoint-lg</VARIABLE><PUNCTUATION>)</PUNCTUATION> <PUNCTUATION>{</PUNCTUATION> <KEYWORD>@content</KEYWORD><PUNCTUATION>;</PUNCTUATION> <PUNCTUATION>}</PUNCTUATION>
