/zepto
*.swp
website/out/
.DS_Store
perflog*.txt
foo.txt

# Test scratch files must NEVER be created in the repo root. QA scripts and
# unit tests create their own scratch dirs via mktemp/File::Temp (see
# qa/lib/qa-helpers.sh: qa_project/qa_git_repo). These patterns exist as a
# safety net in case a test is ever written incorrectly and leaks debris
# into the repo root — they should normally never match anything tracked.
/file_*.txt
/item_*.txt
/*.tmp
/node_modules/
/.venv/

# Pixel QA tier (qa/pixel) — npm deps, Playwright run artifacts, and
# screenshot baselines are all machine/platform-specific and regenerated
# on demand (see qa/pixel/README.md); nothing here is meant to be committed.
qa/pixel/node_modules/
qa/pixel/test-results/
qa/pixel/playwright-report/
qa/pixel/tests/__screenshots__/
